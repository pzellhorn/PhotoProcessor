{
  "uid": "photoprocessor-pipeline",
  "title": "PhotoProcessor — Pipeline",
  "tags": [
    "photoprocessor"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "title": "Queue health",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Queue depth",
      "description": "Messages waiting per job queue. A rising line means workers are behind.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "photoprocessor_queue_depth",
          "legendFormat": "{{job_type}}",
          "refId": "A"
        }
      ],
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Workers: desired vs ready vs subscribed",
      "description": "Replicas from Kubernetes against consumers actually subscribed to the broker. A gap means pods are up but still loading their model.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 0,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "photoprocessor_workers_replicas",
          "legendFormat": "{{job_type}} desired",
          "refId": "A"
        },
        {
          "expr": "photoprocessor_workers_ready",
          "legendFormat": "{{job_type}} ready",
          "refId": "B"
        },
        {
          "expr": "photoprocessor_queue_consumers",
          "legendFormat": "{{job_type}} subscribed",
          "refId": "C"
        }
      ],
      "id": 3
    },
    {
      "type": "row",
      "title": "Throughput and latency",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Job completion rate",
      "description": "Jobs reaching a terminal state per second, split by outcome.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (job_type, outcome) (rate(photoprocessor_jobs_finished_total[5m]))",
          "legendFormat": "{{job_type}} {{outcome}}",
          "refId": "A"
        }
      ],
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Queue wait (p50 / p95)",
      "description": "How long a job sat in the queue before a worker picked it up. This is the backlog signal that justifies scaling.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 0,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, job_type) (rate(photoprocessor_jobs_queue_wait_seconds_bucket[5m])))",
          "legendFormat": "{{job_type}} p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, job_type) (rate(photoprocessor_jobs_queue_wait_seconds_bucket[5m])))",
          "legendFormat": "{{job_type}} p95",
          "refId": "B"
        }
      ],
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Worker processing time (p50 / p95)",
      "description": "Time a worker actually spent on a job. This is what changes when you swap models or resize pods.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 0,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, job_type) (rate(photoprocessor_jobs_processing_seconds_bucket[5m])))",
          "legendFormat": "{{job_type}} p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, job_type) (rate(photoprocessor_jobs_processing_seconds_bucket[5m])))",
          "legendFormat": "{{job_type}} p95",
          "refId": "B"
        }
      ],
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Enqueue rate",
      "description": "Jobs published per second. Compare against completion rate to see whether you are gaining or losing ground.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (job_type) (rate(photoprocessor_jobs_enqueued_total[5m]))",
          "legendFormat": "{{job_type}}",
          "refId": "A"
        }
      ],
      "id": 8
    },
    {
      "type": "row",
      "title": "Coverage",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "id": 9
    },
    {
      "type": "bargauge",
      "title": "Library coverage by job type",
      "description": "Fraction of eligible media that has a completed job of this type. Video frames count as eligible media, so adding a video moves these.",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 27
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "photoprocessor_jobs_coverage",
          "legendFormat": "{{job_type}}",
          "refId": "A"
        }
      ],
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "Unprocessed media (never run)",
      "description": "Eligible media with no job of this type. This is exactly what the Progress page backfill button drains.",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 27
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "photoprocessor_jobs_never_run",
          "legendFormat": "{{job_type}}",
          "refId": "A"
        }
      ],
      "id": 11
    },
    {
      "type": "timeseries",
      "title": "Failed media by job type",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 27
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "photoprocessor_jobs_failed",
          "legendFormat": "{{job_type}}",
          "refId": "A"
        }
      ],
      "id": 12
    },
    {
      "type": "row",
      "title": "Semantic search (synchronous path)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "id": 13
    },
    {
      "type": "timeseries",
      "title": "Search latency vs CLIP text encode",
      "description": "The gap between these two lines is everything that is not the model: pgvector lookup plus hydration.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 35
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 0,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(photoprocessor_search_duration_seconds_bucket[5m])))",
          "legendFormat": "search p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(photoprocessor_textencoder_duration_seconds_bucket[5m])))",
          "legendFormat": "text encode p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(photoprocessor_search_duration_seconds_bucket[5m])))",
          "legendFormat": "search p50",
          "refId": "C"
        }
      ],
      "id": 14
    },
    {
      "type": "timeseries",
      "title": "Search failures",
      "description": "Searches that could not be served, by cause. A spike on text_encoder means the CLIP service is unreachable.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 35
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (reason) (rate(photoprocessor_search_failures_total[5m]))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ],
      "id": 15
    },
    {
      "type": "row",
      "title": "Infrastructure",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 43
      },
      "id": 16
    },
    {
      "type": "timeseries",
      "title": "API request rate by endpoint",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 44
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (http_route) (rate(http_server_request_duration_seconds_count[5m]))",
          "legendFormat": "{{http_route}}",
          "refId": "A"
        }
      ],
      "id": 17
    },
    {
      "type": "timeseries",
      "title": "RabbitMQ messages ready",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 44
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rabbitmq_queue_messages_ready",
          "legendFormat": "{{queue}}",
          "refId": "A"
        }
      ],
      "id": 18
    },
    {
      "type": "timeseries",
      "title": "Postgres connections",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 44
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (datname) (pg_stat_database_numbackends)",
          "legendFormat": "{{datname}}",
          "refId": "A"
        }
      ],
      "id": 19
    }
  ]
}
