FROM python:3.11-slim

WORKDIR /app

ENV HF_HOME=/app/hf \
    PIP_DEFAULT_TIMEOUT=120 \
    PIP_RETRIES=10

COPY flower_identification/requirements.txt ./requirements.txt
RUN --mount=type=cache,target=/root/.cache/pip pip install -r requirements.txt
 
COPY flower_identification/__init__.py flower_identification/prepareModels.py ./flower_identification/
RUN python -m flower_identification.prepareModels

COPY worker_core ./worker_core
COPY flower_identification ./flower_identification

ENV HF_HUB_OFFLINE=1
CMD ["python", "-m", "flower_identification.flowerIdentificationWorker"]
